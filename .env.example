# Copy this file to .env and fill in your own values. Never commit .env.

# Email the SEC can use to contact you. REQUIRED for live SEC EDGAR data
# (the SEC asks automated clients to identify themselves).
SEC_CONTACT_EMAIL=

# Optional AI commentary. "none" (default) uses the rule-based template, no external calls.
# Other values: anthropic, openai
LLM_PROVIDER=

# API key for the provider above. Leave empty if LLM_PROVIDER is none.
LLM_API_KEY=

# Model name for the provider above (see the provider's current docs).
LLM_MODEL=
